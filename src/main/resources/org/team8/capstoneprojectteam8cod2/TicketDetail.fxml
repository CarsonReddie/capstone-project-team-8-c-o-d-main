<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.team8.controller.TicketDetailController"
            style="-fx-background-color: #f2f7ff;"
            prefWidth="1200.0" prefHeight="800.0">

    <top>
        <Label text="Ticket Details"
               style="-fx-font-size:24; -fx-font-weight:bold; -fx-text-fill:#003366;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <GridPane hgap="15" vgap="12">
            <!-- FIXED padding -->
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" prefWidth="150"/>
                <ColumnConstraints halignment="LEFT" prefWidth="350"/>
            </columnConstraints>

            <Label text="Ticket Code:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblCode" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Asset Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblAsset" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Status:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblStatus" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Employee ID:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="lblEmployee" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Date Submitted:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="lblDate" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Issue Description:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextArea fx:id="txtDescription"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"
                      wrapText="true" editable="false" prefRowCount="5"/>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER">
            <!-- FIXED padding -->
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Button text="Close"
                    onAction="#handleClose"
                    style="-fx-background-color:#d9534f;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;
                           -fx-background-radius:8;"/>
        </HBox>
    </bottom>

</BorderPane>
