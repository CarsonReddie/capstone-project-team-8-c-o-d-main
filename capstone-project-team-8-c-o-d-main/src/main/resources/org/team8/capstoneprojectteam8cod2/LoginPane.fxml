<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.team8.controller.LoginController"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0"
            style="-fx-background-color: linear-gradient(to bottom right, #dce7f7, #ffffff);">

    <children>

        <VBox alignment="CENTER"
              spacing="20"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              style="-fx-padding: 40;">

            <!-- Title -->
            <Label text="IT Asset Tracker Login"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill:#003366;" />

            <!-- Username -->
            <TextField fx:id="usernameField"
                       promptText="Username"
                       maxWidth="400"
                       style="-fx-background-radius:8; -fx-border-radius:8; -fx-padding:10;" />

            <!-- Password -->
            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           maxWidth="400"
                           style="-fx-background-radius:8; -fx-border-radius:8; -fx-padding:10;" />

            <!-- Login Button -->
            <Button fx:id="loginButton"
                    text="Login"
                    maxWidth="200"
                    style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:8;"
                    onAction="#handleLogin" />

            <!-- Error Label -->
            <Label fx:id="errorLabel"
                   textFill="red"
                   visible="false"
                   style="-fx-font-size:14;" />
        </VBox>

    </children>
</AnchorPane>
