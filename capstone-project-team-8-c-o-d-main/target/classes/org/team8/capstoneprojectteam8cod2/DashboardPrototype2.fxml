<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="dashboardRoot"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.team8.controller.DashboardController"
            style="-fx-background-color: linear-gradient(to bottom right, #e8f1fa, #ffffff);"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              style="-fx-padding: 10;">

            <!-- Dashboard Title -->
            <Label text="Asset Management Dashboard"
                   style="-fx-font-size:26; -fx-font-weight:bold; -fx-text-fill:#003366;" />

            <!-- Navigation Buttons -->
            <HBox alignment="CENTER" spacing="12">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <Button fx:id="approveButton"
                        text="Approve Ticket"
                        prefWidth="150"
                        onAction="#handleApproveTicket"
                        style="-fx-background-color:#0078D7; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:8;" />

                <Button fx:id="submitTicketButton"
                        text="Submit Ticket"
                        prefWidth="150"
                        onAction="#handleSubmitTicket"
                        style="-fx-background-color:#0078D7; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:8;" />

                <Button fx:id="viewTicketsButton"
                        text="View Tickets"
                        prefWidth="150"
                        onAction="#handleViewTickets"
                        style="-fx-background-color:#0078D7; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:8;" />

                <Button fx:id="retireAssetButton"
                        text="Retire Asset"
                        prefWidth="150"
                        onAction="#handleOpenRetirementTicket"
                        style="-fx-background-color:#0078D7; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:8;" />

                <Button fx:id="logoutButton"
                        text="Logout"
                        prefWidth="150"
                        onAction="#handleLogout"
                        style="-fx-background-color:#d9534f; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:8;" />
            </HBox>

            <Separator style="-fx-background-color:#003366;" />

            <!-- Search + Refresh -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets top="5" right="10" bottom="5" left="10"/>
                </padding>

                <Label text="Search:"
                       style="-fx-font-size:14; -fx-text-fill:#003366; -fx-font-weight:bold;" />

                <TextField fx:id="searchField"
                           promptText="Filter tickets..."
                           prefWidth="250"
                           onKeyReleased="#handleSearch"
                           style="-fx-background-radius:6; -fx-border-color:#0078D7; -fx-border-radius:6;" />

                <Button fx:id="btnRefresh"
                        text="Refresh"
                        prefWidth="100"
                        onAction="#onRefresh"
                        style="-fx-background-color:#00a651; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:8;" />
            </HBox>

            <!-- Tickets Table -->
            <TableView fx:id="tableTickets"
                       VBox.vgrow="ALWAYS"
                       style="-fx-border-color:#c0c0c0; -fx-background-color:white; -fx-border-radius:6;">
                <columns>
                    <TableColumn fx:id="colCode" text="Ticket Code" prefWidth="150"/>
                    <TableColumn fx:id="colAsset" text="Asset" prefWidth="200"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                    <TableColumn fx:id="colEmployee" text="Employee" prefWidth="150"/>
                    <TableColumn fx:id="colSubmitted" text="Submitted" prefWidth="200"/>
                </columns>
            </TableView>

            <!-- Footer -->
            <HBox alignment="CENTER_RIGHT">
                <padding>
                    <Insets top="10" right="10" bottom="5" left="10"/>
                </padding>
                <Label text="© 2025 Team 8 Asset Manager"
                       style="-fx-text-fill:#555555; -fx-font-size:12;" />
            </HBox>

        </VBox>

    </children>
</AnchorPane>
